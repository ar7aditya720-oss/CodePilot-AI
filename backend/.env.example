# NVIDIA Build remote API (recommended for CodePilot AI)
# Generate a key at https://build.nvidia.com/ and keep it private.
# Copy this file to .env.local and set your real key there.
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen2.5-coder-32b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional local AI via Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Legacy OpenAI-compatible API settings (used only when NVIDIA_* variables are unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
